# Copy this file to .env and fill in real values for LOCAL testing.
# On Render, set these as real Environment Variables in the dashboard instead
# — never upload an actual .env file there.

# Required — connection string for your Postgres database.
# Locally: postgres://postgres:yourpassword@localhost:5432/onetag_test
# On Render: copy the "Internal Database URL" from your Postgres instance page.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Required before going live — your first admin login (super_admin, sees all schools).
# Without these set, the app creates a DEFAULT account (ouqi / change-me-now)
# and warns loudly in the logs until you override it.
SUPER_ADMIN_USERNAME=ouqi
SUPER_ADMIN_PASSWORD=choose-a-real-password-here

# Required before going live — admin key for the language-switch endpoint.
# Treat like a password. Without this set, a default fallback is used
# and the app warns loudly in the logs.
ADMIN_KEY=change-me-to-something-long-and-random

# Required for real OTP emails (registration edits, admin setup, parent portal).
# Without these set, OTP codes just print to the server console (fine for
# local testing, NOT fine for real parents).
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification turned on for that Gmail account first).
EMAIL_USER=your-onetag-account@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
