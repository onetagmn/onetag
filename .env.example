# Copy this file to .env and fill in real values for LOCAL testing.
# On Render, set these as real Environment Variables in the dashboard instead
# — never upload an actual .env file there.

# Required — connection string for your Postgres database.
# Locally: postgres://postgres:yourpassword@localhost:5432/onetag_test
# On Render: copy the "Internal Database URL" from your Postgres instance page.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Required before going live — your first admin login (super_admin, sees all schools).
# Without these set, the app creates a DEFAULT account (ouqi / change-me-now)
# and warns loudly in the logs until you override it.
SUPER_ADMIN_USERNAME=ouqi
SUPER_ADMIN_PASSWORD=choose-a-real-password-here

# Required before going live — admin key for the language-switch endpoint.
# Treat like a password. Without this set, a default fallback is used
# and the app warns loudly in the logs.
ADMIN_KEY=change-me-to-something-long-and-random

# Required before going live — shared secret for the tag-writer scripts
# (write-tags.js, prepare-tag.js) that bind a physical wristband's UID to
# a tag_id. Without this set, a default fallback is used and anyone could
# silently rebind which wristband a tag_id points to.
TAG_WRITE_KEY=change-me-to-something-long-and-random

# Required before going live — shared secret the unattended gate-reader
# device (public/gate-listener.html) sends with every check-in/check-out.
# Entered ONCE into that page's setup screen per physical device (it saves
# to that browser's localStorage) — never hardcode this in the HTML file
# itself, since public/ is served to anyone on the internet.
GATE_DEVICE_KEY=change-me-to-something-long-and-random

# Optional — comma-separated list of origins allowed to call this API via
# CORS. Defaults to the production onrender.com URL + localhost if unset.
# Only needed if a genuinely separate site/app needs to call this API.
# ALLOWED_ORIGINS=https://onetag-0b04.onrender.com,https://yourschool.org

# Required for real OTP emails (registration edits, admin setup, parent portal),
# and used by scripts/backup.js to email you the database backup.
# Without these set, OTP codes just print to the server console (fine for
# local testing, NOT fine for real parents).
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification turned on for that Gmail account first).
EMAIL_USER=your-onetag-account@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# Optional — where scripts/backup.js emails the backup file. Defaults to
# EMAIL_USER (i.e. it emails itself) if unset.
# BACKUP_EMAIL_TO=you@example.com

# Optional — enables the real Call Guardian click-to-call relay via Twilio.
# Without these set, the "Call Guardian" button tells the visitor calling
# isn't set up yet instead of silently failing. Get these from
# https://console.twilio.com — TWILIO_PHONE_NUMBER must be a Twilio number
# capable of making outbound voice calls.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
